{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "node",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@common/*": [
        "common/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/main/**/*",
    "src/common/**/*",
    "src/preload/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
